# ============================================================
# Waylo (AuraTour) — Variables de Entorno y Credenciales
# Copia este archivo a `.env` y completa con tus credenciales reales.
# ============================================================

# 1. Supabase (Backend & Realtime)
# Para desarrollo local con Supabase CLI:
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM0NDk2MDB9.CRXP_demo_anon_key_for_local_testing

# Para producción (Supabase Cloud):
# SUPABASE_URL=https://xyzcompany.supabase.co
# SUPABASE_ANON_KEY=eyJ...

# 2. Mapbox (Mapas vectoriales offline y estilos)
# Obtén tu token público en https://account.mapbox.com/
MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoiZGVtbyIsImEiOiJjbHRlc3QwMTEwMDAwMXBqMHRleHQifQ.demo
MAPBOX_STYLE_URL=mapbox://styles/mapbox/outdoors-v12

# 3. OpenWeather (Plan B Instantáneo según clima)
# Clave gratuita obtenida en https://openweathermap.org/api
OPEN_WEATHER_API_KEY=your_openweather_api_key_here

# 4. Códigos de Afiliado (Deep Linking y Monetización)
SKYSCANNER_AFFILIATE_ID=waylo_partner_pro
BOOKING_AFFILIATE_ID=waylo_travel_pro
KAYAK_AFFILIATE_ID=waylo_pkg_affiliate
HOSTELWORLD_AFFILIATE_ID=waylo_social_stays

# 5. Geofencing Defaults
GEOFENCE_RADIUS_METERS=40
DEFAULT_LANGUAGE=es
